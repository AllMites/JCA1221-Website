# OS files
.DS_Store
**/.DS_Store

# Dependencies
node_modules/

# Build output
dist/

# IDE
.idea/
*.swp
*.swo

# Environment
.env
.env.local
.env.*.local

# Claude worktrees and per-developer overrides.
# This was a bare `.claude/`, which was broader than its own comment: it silently
# swallowed `git add .claude/settings.json` and `.claude/hooks/`, i.e. exactly the
# gate wiring that has to be committed for every clone to get the same gate.
.claude/worktrees/
.claude/settings.local.json

# Logs
*.log
npm-debug.log*

# Playwright MCP snapshots
.playwright-mcp/

# Verification screenshots
verify-*.png

# Local Netlify folder
.netlify

# Obsidian graph output
graphify-out/

# Printouts / page exports
printouts/

# Screenshots / mockup exports in root (stay in design tool, not repo)
/*.png
/*.jpeg
/*.jpg

# Project docs tooling
.impeccable/

# Gate caches. ESLint's --cache writes .eslintcache into the cwd; without this line
# the gate would dirty the tree it just checked and gates/git-tree-guard.sh would
# fail on the second run of every card. Left at the default per-worktree location on
# purpose — node_modules/ is a symlink shared by every worktree here.
.eslintcache

